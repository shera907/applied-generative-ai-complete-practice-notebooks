# =========================================
# Global defaults
# =========================================
* text=auto

# =========================================
# Force LF line endings (cross-platform safe)
# =========================================
*.py        text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.toml      text eol=lf
*.ini       text eol=lf
*.cfg       text eol=lf
*.sh        text eol=lf

# =========================================
# Jupyter Notebooks
# =========================================
*.ipynb    text eol=lf

# Optional: make diffs cleaner on GitHub
*.ipynb    diff=jupyter

# =========================================
# Binary files (never normalize)
# =========================================
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.svg      binary
*.pdf      binary
*.zip      binary
*.tar      binary
*.gz       binary
*.pt       binary
*.pth      binary
*.onnx     binary
*.pkl      binary
*.joblib  binary
